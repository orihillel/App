node_modules
dist
dist-ssr
*.local
.DS_Store

# Cloudflare Worker (worker/) local state and secrets — never committed.
.wrangler
.dev.vars
.dev.vars.*

# Seeded design-canvas output: ~2.5MB of generated editor payload, rebuilt by the
# design skill from the .dc.html sources beside it. The sources are the thing worth keeping.
.design/*.html
!.design/*.dc.html

# android/'s upload-signing keystore. This is a permanent credential -- whoever holds it can
# publish updates to the Play Store listing under this app's identity -- never committed, same
# as the Worker's secrets above. See android/README.md for what to do with it instead.
android/*.jks
android/*.keystore
# Bubblewrap's own build output, if `bubblewrap build` is ever run here.
android/app/build
android/build
android/.gradle
